---
import { misi } from '../data/campaign';
---

<section id="misi">
  <h2>Misi</h2>
  <div class="misi">
    {misi.map((m) => (
      <div class="win">
        <div class={`bar ${m.isPink ? 'pk' : ''}`}>{m.title}</div>
        <div class="body">{m.text}</div>
      </div>
    ))}
  </div>
</section>

<style>
  .misi {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    counter-reset: m;
  }

  .misi .win {
    counter-increment: m;
  }

  .misi .body::before {
    content: counter(m);
    float: left;
    margin: 0 12px 0 0;
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    background: var(--p2);
    color: #fff;
    border: 2px solid var(--ln);
    font: 400 24px 'Bagel Fat One';
  }

  @media (max-width: 820px) {
    .misi {
      grid-template-columns: 1fr;
    }
  }
</style>
