---
import { kegiatanRutin } from '../data/campaign';
---

<section id="rutin">
  <h2>Termasuk Kegiatan Rutin:</h2>
  <p class="intro">
    Selain program kerja inovatif di atas, Paslon 02 siap mengawal, menyukseskan, dan memaksimalkan seluruh agenda kegiatan rutin tahunan Homeschooling Pewaris Bangsa:
  </p>

  <div class="rutin-grid">
    {kegiatanRutin.map((item, index) => (
      <div class="win rutin-card">
        <div class={`bar ${item.isPinkHeader ? 'pk' : ''}`}>
          {item.windowTitle}
          <span><i></i><i></i><i></i></span>
        </div>
        <div class="body">
          <div class="card-head">
            <span class="chip">{item.category}</span>
            <span class="badge-num">#0{index + 1}</span>
          </div>
          <h3><em>{item.title}</em></h3>
          <p>{item.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .intro {
    max-width: 760px;
    margin: -6px 0 24px;
    font-size: 18px;
    color: #243836;
    line-height: 1.6;
  }

  .rutin-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: stretch;
  }

  .rutin-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .rutin-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 8px 8px 0 var(--ln);
  }

  .rutin-card .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 16px;
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .badge-num {
    font-family: 'Bagel Fat One', system-ui, sans-serif;
    font-size: 15px;
    color: var(--p1);
    background: var(--t3);
    border: 2px solid var(--ln);
    padding: 1px 7px;
    box-shadow: 2px 2px 0 var(--ln);
  }

  .rutin-card h3 {
    font-size: 22px;
    color: var(--p1);
    margin: 4px 0 10px;
    line-height: 1.25;
  }

  .rutin-card p {
    margin: 0;
    line-height: 1.55;
    color: var(--ink);
    font-size: 16px;
  }

  @media (max-width: 960px) {
    .rutin-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .rutin-grid {
      grid-template-columns: 1fr;
    }
    .intro {
      font-size: 16px;
    }
  }
</style>
