---
import { candidates } from '../data/campaign';
---

<section id="profil">
  <h2>Profil Calon</h2>
  <div class="two">
    {candidates.map((c) => (
      <div class="win">
        <div class={`bar ${c.isPinkHeader ? 'pk' : ''}`}>
          {c.windowTitle}
          <span><i></i><i></i><i></i></span>
        </div>
        <div class="body pro">
          <img
            src={c.image}
            alt={c.imageAlt}
            width="150"
            height="187"
            loading="lazy"
          />
          <div>
            <h3>{c.name}</h3>
            <div class="role">{c.role}</div>
            <p style="margin: 4px 0">{c.bio}</p>
            {c.tags.map((tag) => (
              <span class="chip">{tag}</span>
            ))}
          </div>
        </div>
        <div class="body experience">
          <b>Pengalaman:</b> {c.experience}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .pro {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 14px;
  }

  .pro img {
    width: 150px;
    height: 187px;
    object-fit: cover;
    object-position: top;
    background: #fff;
    border: 2px solid var(--ln);
  }

  .experience {
    border-top: 2px solid var(--ln);
  }

  @media (max-width: 820px) {
    .two {
      grid-template-columns: 1fr;
    }
    .pro {
      grid-template-columns: 110px 1fr;
    }
    .pro img {
      width: 110px;
      height: 137px;
    }
  }
</style>
