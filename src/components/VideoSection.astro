---
import { siteConfig } from '../data/campaign';
---

<section id="video">
  <h2>Video Kampanye</h2>
  <div class="win">
    <div class="bar pk">
      {siteConfig.video.windowTitle}
      <span><i></i><i></i><i></i></span>
    </div>
    <video
      controls
      playsinline
      preload="metadata"
      poster={siteConfig.video.poster}
      src={siteConfig.video.src}
    >
      Browser Anda tidak mendukung pemutaran video.
    </video>
  </div>
</section>

<style>
  video {
    display: block;
    width: 100%;
    max-height: 80vh;
    background: #000;
  }
</style>
